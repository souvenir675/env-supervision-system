<template>
    <div class="admin-container">
        <!-- 页面头部 -->
        <div class="page-header">
            <div class="header-left">
                <h2>系统管理仪表板</h2>
                <p>管理公众监督数据、指派网格员、查看统计报表</p>
            </div>
            <div class="header-right">
                <el-tag type="success" size="large">
                    <el-icon><Setting /></el-icon>
                    管理员：{{ userInfo.userName || '未登录' }}
                </el-tag>
            </div>
        </div>

        <!-- 统计概览 -->
        <el-row :gutter="20" class="stat-cards">
            <el-col :span="6">
                <div class="stat-card" style="border-left-color: #409eff;">
                    <div class="stat-number">{{ statistics.totalFeedback }}</div>
                    <div class="stat-label">当前列表</div>
                </div>
            </el-col>
            <el-col :span="6">
                <div class="stat-card" style="border-left-color: #e6a23c;">
                    <div class="stat-number">{{ statistics.unassigned }}</div>
                    <div class="stat-label">待指派</div>
                </div>
            </el-col>
            <el-col :span="6">
                <div class="stat-card" style="border-left-color: #409eff;">
                    <div class="stat-number">{{ statistics.assigned }}</div>
                    <div class="stat-label">已指派</div>
                </div>
            </el-col>
            <el-col :span="6">
                <div class="stat-card" style="border-left-color: #67c23a;">
                    <div class="stat-number">{{ statistics.confirmed }}</div>
                    <div class="stat-label">已确认</div>
                </div>
            </el-col>
        </el-row>

        <!-- Tab切换 -->
        <el-tabs v-model="activeTab" class="admin-tabs" @tab-change="handleTabChange">
            <!-- 反馈管理 -->
            <el-tab-pane label="反馈管理" name="feedback">
                <el-card shadow="hover">
                    <template #header>
                        <div class="card-header">
                            <span>公众监督反馈列表</span>
                            <div class="header-actions">
                                <el-input
                                    v-model="feedbackQuery.keyword"
                                    placeholder="搜索地址或描述"
                                    prefix-icon="Search"
                                    clearable
                                    style="width: 180px; margin-right: 12px"
                                />
                                <el-select
                                    v-model="feedbackQuery.state"
                                    placeholder="状态"
                                    clearable
                                    style="width: 120px; margin-right: 12px"
                                >
                                    <el-option label="全部" value="" />
                                    <el-option label="未指派" value="0" />
                                    <el-option label="已指派" value="1" />
                                    <el-option label="已确认" value="2" />
                                </el-select>
                                <el-button type="primary" @click="loadFeedbackList">
                                    <el-icon><Refresh /></el-icon>
                                    刷新
                                </el-button>
                            </div>
                        </div>
                    </template>

                    <el-table :data="feedbackList" border stripe v-loading="feedbackLoading">
                        <el-table-column prop="afId" label="编号" width="80" align="center" />
                        <el-table-column prop="provinceName" label="省份" width="90" />
                        <el-table-column prop="cityName" label="城市" width="90" />
                        <el-table-column prop="address" label="地址" min-width="150" show-overflow-tooltip />
                        <el-table-column prop="estimatedGrade" label="预估等级" width="130" align="center">
                            <template #default="{ row }">
                                <el-tag
                                    :color="getAqiColor(row.estimatedGrade)"
                                    style="color: #fff; border: none; min-width: 50px; text-align: center"
                                >
                                    {{ getAqiLabel(row.estimatedGrade) }}
                                </el-tag>
                            </template>
                        </el-table-column>
                        <el-table-column prop="state" label="状态" width="100" align="center">
                            <template #default="{ row }">
                                <el-tag :type="getStateType(row.state)">
                                    {{ getStateLabel(row.state) }}
                                </el-tag>
                            </template>
                        </el-table-column>
                        <el-table-column prop="afDate" label="日期" width="110" align="center" />
                        <el-table-column label="操作" width="200" align="center" fixed="right">
                            <template #default="{ row }">
                                <el-button type="text" size="small" @click="viewFeedbackDetail(row)">详情</el-button>
                                <el-button
                                    v-if="row.state === 0"
                                    type="primary"
                                    size="small"
                                    @click="openAssignDialog(row)"
                                >
                                    指派
                                </el-button>
                            </template>
                        </el-table-column>
                    </el-table>

                    <el-pagination
                        v-model:page-size="feedbackQuery.pageSize"
                        v-model:current-page="feedbackQuery.pageNum"
                        :total="feedbackTotal"
                        layout="total, prev, pager, next, sizes"
                        @change="loadFeedbackList"
                    />
                </el-card>
            </el-tab-pane>

            <!-- 确认AQI数据管理 -->
            <el-tab-pane label="确认AQI数据管理" name="aqiData">
                <el-card shadow="hover">
                    <template #header>
                        <div class="card-header">
                            <span>确认AQI数据列表</span>
                            <div class="header-actions">
                                <el-select v-model="statisticsQuery.provinceId" placeholder="选择省份" clearable
                                    style="width: 160px; margin-right: 10px" @change="handleStatisticsSearch">
                                    <el-option v-for="p in provinceList" :key="p.provinceId" :label="p.provinceName"
                                        :value="p.provinceId" />
                                </el-select>
                                <el-button type="primary" @click="handleStatisticsSearch">
                                    <el-icon><Search /></el-icon>
                                    查询
                                </el-button>
                                <el-button @click="handleStatisticsReset">
                                    <el-icon><RefreshLeft /></el-icon>
                                    重置
                                </el-button>
                            </div>
                        </div>
                    </template>

                    <el-table :data="statisticsList" border stripe v-loading="statisticsLoading">
                        <el-table-column prop="id" label="编号" width="80" align="center" />
                        <el-table-column prop="provinceName" label="所在省" width="110" />
                        <el-table-column prop="cityName" label="所在市" width="110" />
                        <el-table-column prop="aqiId" label="AQI等级" width="140" align="center">
                            <template #default="{ row }">
                                <el-tag
                                    :color="row.aqiColor || getAqiColor(row.aqiId)"
                                    style="color: #fff; border: none; min-width: 60px; text-align: center"
                                >
                                    {{ getAqiLabel(row.aqiId) }}
                                </el-tag>
                            </template>
                        </el-table-column>
                        <el-table-column prop="confirmDate" label="确认日期" width="120" align="center" />
                        <el-table-column prop="confirmTime" label="确认时间" width="110" align="center" />
                        <el-table-column prop="gmName" label="网格员" width="110" align="center" />
                        <el-table-column prop="fdName" label="反馈者" width="110" align="center" />
                        <el-table-column label="操作" width="120" align="center" fixed="right">
                            <template #default="{ row }">
                                <el-button type="primary" size="small" @click="viewStatisticsDetail(row)">
                                    查看详情
                                </el-button>
                            </template>
                        </el-table-column>
                    </el-table>

                    <el-pagination
                        v-model:page-size="statisticsQuery.pageSize"
                        v-model:current-page="statisticsQuery.pageNum"
                        :total="statisticsTotal"
                        layout="total, prev, pager, next, sizes"
                        style="margin-top: 16px; justify-content: flex-end"
                        @change="loadStatisticsList"
                    />

                    <el-empty v-if="!statisticsLoading && statisticsList.length === 0" description="暂无确认数据" />
                </el-card>
            </el-tab-pane>

            <!-- 网格员管理（新增） -->
            <el-tab-pane label="网格员管理" name="gridMember">
                <el-card shadow="hover">
                    <template #header>
                        <div class="card-header">
                            <span>网格员列表</span>
                            <div class="header-actions">
                                <el-button type="primary" @click="openRegisterDialog">
                                    <el-icon><Plus /></el-icon>
                                    注册网格员
                                </el-button>
                                <el-button type="success" @click="loadGridMemberList">
                                    <el-icon><Refresh /></el-icon>
                                    刷新
                                </el-button>
                            </div>
                        </div>
                    </template>

                    <el-table :data="gridMemberList" border stripe v-loading="gridMemberLoading">
                        <el-table-column prop="gmId" label="手机号" width="130" align="center" />
                        <el-table-column prop="gmName" label="姓名" width="100" align="center" />
                        <el-table-column prop="gmCode" label="登录编码" width="110" align="center" />
                        <el-table-column prop="provinceName" label="省份" width="100" />
                        <el-table-column prop="cityName" label="城市" width="100" />
                        <el-table-column prop="tel" label="联系电话" width="130" align="center" />
                        <el-table-column prop="state" label="状态" width="100" align="center">
                            <template #default="{ row }">
                                <el-tag :type="getGridMemberStateType(row.state)">
                                    {{ getGridMemberStateLabel(row.state) }}
                                </el-tag>
                            </template>
                        </el-table-column>
                        <el-table-column prop="remarks" label="备注" min-width="120" show-overflow-tooltip />
                        <el-table-column label="操作" width="100" align="center" fixed="right">
                            <template #default="{ row }">
                                <el-button type="danger" size="small" @click="handleDeleteGridMember(row)">
                                    删除
                                </el-button>
                            </template>
                        </el-table-column>
                    </el-table>

                    <el-empty v-if="!gridMemberLoading && gridMemberList.length === 0" description="暂无网格员" />
                </el-card>
            </el-tab-pane>

            <!-- 统计数据 -->
            <el-tab-pane label="统计数据" name="statistics">
                <div class="statistics-wrapper">
                    <!-- 统计类型下拉选择 -->
                    <div class="statistics-selector">
                        <span class="selector-label">统计类型：</span>
                        <el-select
                            v-model="currentStatType"
                            placeholder="请选择统计类型"
                            size="large"
                            style="width: 320px"
                            @change="handleStatTypeChange"
                        >
                            <el-option label="省分组检查统计" value="province" />
                            <el-option label="AQI指数分布统计" value="distribution" />
                            <el-option label="AQI指数趋势统计" value="trend" />
                            <el-option label="实时统计 & 网格覆盖率" value="realtime" />
                        </el-select>
                        <el-button type="primary" @click="loadCurrentStatData" style="margin-left: 12px">
                            <el-icon><Refresh /></el-icon>
                            刷新
                        </el-button>
                    </div>

                    <!-- ========== 省分组检查统计 ========== -->
                    <div v-if="currentStatType === 'province'" class="stat-panel">
                        <!-- 表格 -->
                        <el-card shadow="hover" class="stat-table-card">
                            <template #header>
                                <div class="card-header">
                                    <span>省分组检查统计表</span>
                                </div>
                            </template>
                            <el-table :data="provinceStatisticsList" border stripe v-loading="statLoading">
                                <el-table-column prop="provinceId" label="省编号" width="100" align="center" />
                                <el-table-column prop="provinceName" label="省名称" width="150" align="center" />
                                <el-table-column prop="so2ExceedCount" label="SO₂超标累计" width="140" align="center">
                                    <template #default="{ row }">
                                        <span :style="{ color: row.so2ExceedCount > 0 ? '#f56c6c' : '#67c23a', fontWeight: 'bold' }">
                                            {{ row.so2ExceedCount || 0 }}
                                        </span>
                                    </template>
                                </el-table-column>
                                <el-table-column prop="coExceedCount" label="CO超标累计" width="140" align="center">
                                    <template #default="{ row }">
                                        <span :style="{ color: row.coExceedCount > 0 ? '#e6a23c' : '#67c23a', fontWeight: 'bold' }">
                                            {{ row.coExceedCount || 0 }}
                                        </span>
                                    </template>
                                </el-table-column>
                                <el-table-column prop="spmExceedCount" label="PM2.5超标累计" width="160" align="center">
                                    <template #default="{ row }">
                                        <span :style="{ color: row.spmExceedCount > 0 ? '#409eff' : '#67c23a', fontWeight: 'bold' }">
                                            {{ row.spmExceedCount || 0 }}
                                        </span>
                                    </template>
                                </el-table-column>
                                <el-table-column prop="aqiExceedCount" label="AQI超标累计" width="140" align="center">
                                    <template #default="{ row }">
                                        <span :style="{ color: row.aqiExceedCount > 0 ? '#f56c6c' : '#67c23a', fontWeight: 'bold' }">
                                            {{ row.aqiExceedCount || 0 }}
                                        </span>
                                    </template>
                                </el-table-column>
                            </el-table>
                            <el-empty v-if="!statLoading && provinceStatisticsList.length === 0" description="暂无数据" />
                        </el-card>

                        <!-- 图表 -->
                        <el-card shadow="hover" class="stat-chart-card">
                            <template #header>
                                <div class="card-header">
                                    <span>省分组检查统计图</span>
                                </div>
                            </template>
                            <div ref="provinceChartRef" class="chart-container"></div>
                        </el-card>
                    </div>

                    <!-- ========== AQI指数分布统计 ========== -->
                    <div v-if="currentStatType === 'distribution'" class="stat-panel">
                        <!-- 表格 -->
                        <el-card shadow="hover" class="stat-table-card">
                            <template #header>
                                <div class="card-header">
                                    <span>AQI空气质量指数级别分布表</span>
                                </div>
                            </template>
                            <el-table :data="distributionList" border stripe v-loading="statLoading">
                                <el-table-column prop="aqiId" label="AQI指数等级" width="150" align="center">
                                    <template #default="{ row }">
                                        <el-tag
                                            :color="row.color || getAqiColor(row.aqiId)"
                                            style="color: #fff; border: none; min-width: 50px"
                                        >
                                            {{ row.aqiId }} 级
                                        </el-tag>
                                    </template>
                                </el-table-column>
                                <el-table-column prop="aqiExplain" label="AQI指数等级描述" width="150" align="center" />
                                <el-table-column prop="count" label="AQI指数等级分布统计" min-width="180" align="center">
                                    <template #default="{ row }">
                                        <span style="font-weight: bold; color: #2e7d32;">
                                            {{ row.count || 0 }} 条
                                        </span>
                                        <span style="color: #999; margin-left: 8px;">
                                            ({{ row.percentage || 0 }}%)
                                        </span>
                                    </template>
                                </el-table-column>
                            </el-table>
                            <el-empty v-if="!statLoading && distributionList.length === 0" description="暂无数据" />
                        </el-card>

                        <!-- 图表 -->
                        <el-card shadow="hover" class="stat-chart-card">
                            <template #header>
                                <div class="card-header">
                                    <span>AQI指数分布图</span>
                                </div>
                            </template>
                            <div ref="distributionChartRef" class="chart-container"></div>
                        </el-card>
                    </div>

                    <!-- ========== AQI指数趋势统计 ========== -->
                    <div v-if="currentStatType === 'trend'" class="stat-panel">
                        <!-- 表格 -->
                        <el-card shadow="hover" class="stat-table-card">
                            <template #header>
                                <div class="card-header">
                                    <span>AQI空气质量指数超标趋势表</span>
                                </div>
                            </template>
                            <el-table :data="trendList" border stripe v-loading="statLoading">
                                <el-table-column prop="seqNo" label="序号" width="100" align="center" />
                                <el-table-column prop="month" label="月份" width="200" align="center" />
                                <el-table-column prop="exceedCount" label="AQI空气质量指数超标数量" min-width="200" align="center">
                                    <template #default="{ row }">
                                        <span :style="{ color: row.exceedCount > 0 ? '#f56c6c' : '#67c23a', fontWeight: 'bold' }">
                                            {{ row.exceedCount || 0 }}
                                        </span>
                                    </template>
                                </el-table-column>
                            </el-table>
                            <el-empty v-if="!statLoading && trendList.length === 0" description="暂无数据" />
                        </el-card>

                        <!-- 图表 -->
                        <el-card shadow="hover" class="stat-chart-card">
                            <template #header>
                                <div class="card-header">
                                    <span>AQI指数超标趋势图</span>
                                </div>
                            </template>
                            <div ref="trendChartRef" class="chart-container"></div>
                        </el-card>
                    </div>

                    <!-- ========== 实时统计 & 网格覆盖率 ========== -->
                    <div v-if="currentStatType === 'realtime'" class="stat-panel">
                        <el-card shadow="hover">
                            <template #header>
                                <div class="card-header">
                                    <span>实时统计 &amp; 网格覆盖率</span>
                                </div>
                            </template>

                            <!-- 实时统计 -->
                            <div class="realtime-section">
                                <h4 class="section-subtitle">空气质量检测数量实时统计</h4>
                                <el-row :gutter="20">
                                    <el-col :span="8">
                                        <div class="rt-card" style="border-left-color: #409eff;">
                                            <div class="rt-card-icon" style="background: #e3f2fd; color: #409eff;">
                                                <el-icon><DataLine /></el-icon>
                                            </div>
                                            <div class="rt-card-info">
                                                <div class="rt-card-value">{{ realTime.totalCount || 0 }}</div>
                                                <div class="rt-card-label">AQI检测累计数量</div>
                                            </div>
                                        </div>
                                    </el-col>
                                    <el-col :span="8">
                                        <div class="rt-card" style="border-left-color: #67c23a;">
                                            <div class="rt-card-icon" style="background: #e8f5e9; color: #67c23a;">
                                                <el-icon><CircleCheck /></el-icon>
                                            </div>
                                            <div class="rt-card-info">
                                                <div class="rt-card-value" style="color: #67c23a;">{{ realTime.goodCount || 0 }}</div>
                                                <div class="rt-card-label">检测结果良好累计数量</div>
                                            </div>
                                        </div>
                                    </el-col>
                                    <el-col :span="8">
                                        <div class="rt-card" style="border-left-color: #f56c6c;">
                                            <div class="rt-card-icon" style="background: #ffebee; color: #f56c6c;">
                                                <el-icon><Warning /></el-icon>
                                            </div>
                                            <div class="rt-card-info">
                                                <div class="rt-card-value" style="color: #f56c6c;">{{ realTime.exceedCount || 0 }}</div>
                                                <div class="rt-card-label">检测结果超标累计数量</div>
                                            </div>
                                        </div>
                                    </el-col>
                                </el-row>
                            </div>

                            <el-divider />

                            <!-- 网格覆盖率 -->
                            <div class="coverage-section">
                                <h4 class="section-subtitle">全国网格覆盖率统计</h4>
                                <el-row :gutter="20">
                                    <el-col :span="12">
                                        <div class="coverage-card">
                                            <div class="coverage-header">
                                                <span class="coverage-title">省份覆盖率</span>
                                                <span class="coverage-percent" :style="{ color: coverage.provinceCoverage >= 80 ? '#67c23a' : '#e6a23c' }">
                                                    {{ coverage.provinceCoverage || 0 }}%
                                                </span>
                                            </div>
                                            <el-progress
                                                :percentage="coverage.provinceCoverage || 0"
                                                :color="coverage.provinceCoverage >= 80 ? '#67c23a' : '#e6a23c'"
                                                :stroke-width="20"
                                                :show-text="false"
                                            />
                                            <div class="coverage-detail">
                                                已覆盖：{{ coverage.provinceCovered || 0 }} / {{ coverage.provinceTotal || 0 }} 个省
                                            </div>
                                        </div>
                                    </el-col>
                                    <el-col :span="12">
                                        <div class="coverage-card">
                                            <div class="coverage-header">
                                                <span class="coverage-title">城市覆盖率</span>
                                                <span class="coverage-percent" :style="{ color: coverage.cityCoverage >= 80 ? '#67c23a' : '#e6a23c' }">
                                                    {{ coverage.cityCoverage || 0 }}%
                                                </span>
                                            </div>
                                            <el-progress
                                                :percentage="coverage.cityCoverage || 0"
                                                :color="coverage.cityCoverage >= 80 ? '#67c23a' : '#e6a23c'"
                                                :stroke-width="20"
                                                :show-text="false"
                                            />
                                            <div class="coverage-detail">
                                                已覆盖：{{ coverage.cityCovered || 0 }} / {{ coverage.cityTotal || 0 }} 个城市
                                            </div>
                                        </div>
                                    </el-col>
                                </el-row>
                            </div>
                        </el-card>
                    </div>

                    <!-- 空状态 -->
                    <el-empty
                        v-if="!currentStatType"
                        description="请选择要查看的统计类型"
                        :image-size="150"
                        style="padding: 60px 0"
                    />
                </div>
            </el-tab-pane>
        </el-tabs>

        <!-- 反馈详情弹窗（增加反馈者详细信息） -->
        <el-dialog v-model="detailVisible" title="反馈详情" width="720px">
            <div v-if="detailData" class="detail-content">
                <el-descriptions :column="2" border>
                    <!-- 第一行：反馈者信息 -->
                    <el-descriptions-item label="反馈者姓名">
                        <span style="font-weight: 600; color: #2e7d32;">
                            {{ detailData.supervisorName || '未知用户' }}
                        </span>
                    </el-descriptions-item>
                    <el-descriptions-item label="反馈者性别">
                        <span>{{ detailData.supervisorSexDesc || '-' }}</span>
                    </el-descriptions-item>

                    <!-- 第二行：反馈者详细信息 -->
                    <el-descriptions-item label="反馈者出生日期">
                        <span>{{ detailData.supervisorBirthday || '-' }}</span>
                    </el-descriptions-item>
                    <el-descriptions-item label="反馈者联系电话">
                        <span style="color: #409eff; font-weight: 600;">
                            {{ detailData.supervisorTel || detailData.telId || '-' }}
                        </span>
                    </el-descriptions-item>

                    <el-descriptions-item label="反馈编号">{{ detailData.afId }}</el-descriptions-item>
                    <el-descriptions-item label="状态">
                        <el-tag :type="getStateType(detailData.state)">
                            {{ getStateLabel(detailData.state) }}
                        </el-tag>
                    </el-descriptions-item>
                    <el-descriptions-item label="省份">{{ detailData.provinceName }}</el-descriptions-item>
                    <el-descriptions-item label="城市">{{ detailData.cityName }}</el-descriptions-item>
                    <el-descriptions-item label="详细地址" :span="2">{{ detailData.address }}</el-descriptions-item>
                    <el-descriptions-item label="预估AQI等级" :span="2">
                        <el-tag
                            :color="getAqiColor(detailData.estimatedGrade)"
                            style="color: #fff; border: none"
                        >
                            {{ getAqiLabel(detailData.estimatedGrade) }}
                        </el-tag>
                    </el-descriptions-item>
                    <el-descriptions-item label="反馈描述" :span="2">{{ detailData.information }}</el-descriptions-item>
                    <el-descriptions-item label="反馈日期">{{ detailData.afDate }}</el-descriptions-item>
                    <el-descriptions-item label="反馈时间">{{ detailData.afTime }}</el-descriptions-item>
                    <el-descriptions-item v-if="detailData.gridMemberName" label="指派网格员">
                        {{ detailData.gridMemberName }}
                    </el-descriptions-item>
                    <el-descriptions-item v-if="detailData.assignDate" label="指派日期">
                        {{ detailData.assignDate }}
                    </el-descriptions-item>
                </el-descriptions>

                <!-- 实测数据 -->
                <div v-if="detailData.measuredGrade" class="measured-section">
                    <el-divider content-position="left">
                        <span style="color: #2e7d32; font-weight: 600;">实测AQI数据</span>
                    </el-divider>
                    <el-descriptions :column="2" border>
                        <el-descriptions-item label="实测AQI等级" :span="2">
                            <el-tag
                                :color="getAqiColor(detailData.measuredGrade)"
                                style="color: #fff; border: none; font-size: 14px; padding: 6px 16px;"
                            >
                                {{ getAqiLabel(detailData.measuredGrade) }}
                            </el-tag>
                        </el-descriptions-item>
                        <el-descriptions-item label="SO₂实测浓度">{{ detailData.so2Value }} ug/m³</el-descriptions-item>
                        <el-descriptions-item label="CO实测浓度">{{ detailData.coValue }} ug/m³</el-descriptions-item>
                        <el-descriptions-item label="PM2.5实测浓度">{{ detailData.spmValue }} ug/m³</el-descriptions-item>
                        <el-descriptions-item label="确认时间">
                            {{ detailData.confirmDate }} {{ detailData.confirmTime }}
                        </el-descriptions-item>
                    </el-descriptions>
                </div>
            </div>
            <template #footer>
                <el-button @click="detailVisible = false">关闭</el-button>
            </template>
        </el-dialog>

        <!-- AQI确认数据详情弹窗（新增） -->
        <el-dialog v-model="statisticsDetailVisible" title="AQI确认数据详情" width="720px">
            <div v-if="statisticsDetail" class="detail-content">
                <el-descriptions :column="2" border>
                    <el-descriptions-item label="确认数据编号">
                        <span style="font-weight: 600; color: #2e7d32;">{{ statisticsDetail.id }}</span>
                    </el-descriptions-item>
                    <el-descriptions-item label="反馈编号">{{ statisticsDetail.afId }}</el-descriptions-item>
                    <el-descriptions-item label="确认信息所在地址" :span="2">
                        {{ statisticsDetail.provinceName }} {{ statisticsDetail.cityName }} {{ statisticsDetail.address }}
                    </el-descriptions-item>
                    <el-descriptions-item label="确认AQI等级" :span="2">
                        <el-tag
                            :color="statisticsDetail.aqiColor || getAqiColor(statisticsDetail.aqiId)"
                            style="color: #fff; border: none; font-size: 14px; padding: 6px 16px;"
                        >
                            {{ getAqiLabel(statisticsDetail.aqiId) }}
                        </el-tag>
                    </el-descriptions-item>
                    <el-descriptions-item label="确认日期">{{ statisticsDetail.confirmDate }}</el-descriptions-item>
                    <el-descriptions-item label="确认时间">{{ statisticsDetail.confirmTime }}</el-descriptions-item>
                </el-descriptions>

                <!-- 网格员信息 -->
                <div class="info-section">
                    <el-divider content-position="left">
                        <span style="color: #409eff; font-weight: 600;">网格员信息</span>
                    </el-divider>
                    <el-descriptions :column="2" border>
                        <el-descriptions-item label="网格员姓名">
                            <span style="font-weight: 600;">{{ statisticsDetail.gmName || '-' }}</span>
                        </el-descriptions-item>
                        <el-descriptions-item label="网格员电话">
                            <span style="color: #409eff;">{{ statisticsDetail.gmTel || '-' }}</span>
                        </el-descriptions-item>
                    </el-descriptions>
                </div>

                <!-- 公众监督员信息 -->
                <div class="info-section">
                    <el-divider content-position="left">
                        <span style="color: #2e7d32; font-weight: 600;">公众监督员信息</span>
                    </el-divider>
                    <el-descriptions :column="2" border>
                        <el-descriptions-item label="监督员姓名">
                            <span style="font-weight: 600;">{{ statisticsDetail.fdName || '-' }}</span>
                        </el-descriptions-item>
                        <el-descriptions-item label="监督员电话">
                            <span style="color: #409eff;">{{ statisticsDetail.fdTel || '-' }}</span>
                        </el-descriptions-item>
                    </el-descriptions>
                </div>

                <!-- 反馈信息描述 -->
                <div class="info-section">
                    <el-divider content-position="left">
                        <span style="color: #666; font-weight: 600;">公众监督员反馈信息描述</span>
                    </el-divider>
                    <div class="feedback-desc">
                        {{ statisticsDetail.information || '无描述' }}
                    </div>
                </div>

                <!-- 实测数据详情 -->
                <div class="info-section">
                    <el-divider content-position="left">
                        <span style="color: #e6a23c; font-weight: 600;">实测污染物数据</span>
                    </el-divider>
                    <el-descriptions :column="2" border>
                        <el-descriptions-item label="SO₂实测浓度">
                            {{ statisticsDetail.so2Value }} ug/m³
                            <el-tag
                                v-if="statisticsDetail.so2Level"
                                :color="getAqiColor(statisticsDetail.so2Level)"
                                size="small"
                                style="color: #fff; border: none; margin-left: 8px;"
                            >
                                {{ getAqiLabel(statisticsDetail.so2Level) }}
                            </el-tag>
                        </el-descriptions-item>
                        <el-descriptions-item label="CO实测浓度">
                            {{ statisticsDetail.coValue }} ug/m³
                            <el-tag
                                v-if="statisticsDetail.coLevel"
                                :color="getAqiColor(statisticsDetail.coLevel)"
                                size="small"
                                style="color: #fff; border: none; margin-left: 8px;"
                            >
                                {{ getAqiLabel(statisticsDetail.coLevel) }}
                            </el-tag>
                        </el-descriptions-item>
                        <el-descriptions-item label="PM2.5实测浓度">
                            {{ statisticsDetail.spmValue }} ug/m³
                            <el-tag
                                v-if="statisticsDetail.spmLevel"
                                :color="getAqiColor(statisticsDetail.spmLevel)"
                                size="small"
                                style="color: #fff; border: none; margin-left: 8px;"
                            >
                                {{ getAqiLabel(statisticsDetail.spmLevel) }}
                            </el-tag>
                        </el-descriptions-item>
                    </el-descriptions>
                </div>
            </div>
            <template #footer>
                <el-button @click="statisticsDetailVisible = false">关闭</el-button>
            </template>
        </el-dialog>

        <!-- 指派网格员弹窗 -->
        <el-dialog v-model="assignVisible" title="指派网格员" width="500px">
            <div v-if="currentFeedback" class="assign-content">
                <el-descriptions :column="2" border size="small">
                    <el-descriptions-item label="反馈编号">{{ currentFeedback.afId }}</el-descriptions-item>
                    <el-descriptions-item label="地址">{{ currentFeedback.address }}</el-descriptions-item>
                    <el-descriptions-item label="预估等级">
                        <el-tag
                            :color="getAqiColor(currentFeedback.estimatedGrade)"
                            style="color: #fff; border: none"
                        >
                            {{ getAqiLabel(currentFeedback.estimatedGrade) }}
                        </el-tag>
                    </el-descriptions-item>
                    <el-descriptions-item label="状态">
                        <el-tag type="warning">待指派</el-tag>
                    </el-descriptions-item>
                </el-descriptions>

                <el-divider>选择网格员</el-divider>

                <el-select
                    v-model="selectedGridMember"
                    placeholder="请选择可工作的网格员"
                    style="width: 100%"
                    filterable
                >
                    <el-option
                        v-for="item in availableMembers"
                        :key="item.gmId"
                        :label="`${item.gmName} (${item.provinceName} - ${item.cityName})`"
                        :value="item.gmId"
                    />
                </el-select>

                <div v-if="availableMembers.length === 0" style="color: #999; text-align: center; padding: 20px;">
                    当前区域没有可工作的网格员
                </div>
            </div>

            <template #footer>
                <el-button @click="assignVisible = false">取消</el-button>
                <el-button
                    type="primary"
                    :loading="assignLoading"
                    :disabled="!selectedGridMember"
                    @click="handleAssign"
                >
                    {{ assignLoading ? '指派中...' : '确认指派' }}
                </el-button>
            </template>
        </el-dialog>

        <!-- 注册网格员弹窗（新增） -->
        <el-dialog v-model="registerVisible" title="注册网格员" width="560px" :close-on-click-modal="false">
            <el-form
                ref="registerFormRef"
                :model="registerForm"
                :rules="registerRules"
                label-width="120px"
                label-position="right"
            >
                <el-form-item label="手机号" prop="gmId">
                    <el-input
                        v-model="registerForm.gmId"
                        placeholder="请输入手机号"
                        maxlength="11"
                    />
                </el-form-item>

                <el-form-item label="姓名" prop="gmName">
                    <el-input v-model="registerForm.gmName" placeholder="请输入网格员姓名" maxlength="20" />
                </el-form-item>

                <el-form-item label="登录编码" prop="gmCode">
                    <el-input v-model="registerForm.gmCode" placeholder="请输入登录编码（如gm005）" maxlength="20" />
                </el-form-item>

                <el-form-item label="登录密码" prop="password">
                    <el-input
                        v-model="registerForm.password"
                        type="password"
                        placeholder="请输入密码（6-20位）"
                        show-password
                    />
                </el-form-item>

                <el-form-item label="省份" prop="provinceId">
                    <el-select
                        v-model="registerForm.provinceId"
                        placeholder="请选择省份"
                        filterable
                        @change="handleRegisterProvinceChange"
                        style="width: 100%"
                    >
                        <el-option
                            v-for="item in provinceList"
                            :key="item.provinceId"
                            :label="item.provinceName"
                            :value="item.provinceId"
                        />
                    </el-select>
                </el-form-item>

                <el-form-item label="城市" prop="cityId">
                    <el-select
                        v-model="registerForm.cityId"
                        placeholder="请选择城市"
                        filterable
                        :disabled="!registerForm.provinceId"
                        style="width: 100%"
                    >
                        <el-option
                            v-for="item in registerCityList"
                            :key="item.cityId"
                            :label="item.cityName"
                            :value="item.cityId"
                        />
                    </el-select>
                </el-form-item>

                <el-form-item label="联系电话" prop="tel">
                    <el-input v-model="registerForm.tel" placeholder="请输入联系电话" maxlength="20" />
                </el-form-item>

                <el-form-item label="工作状态" prop="state">
                    <el-select v-model="registerForm.state" placeholder="请选择工作状态" style="width: 100%">
                        <el-option label="可工作" :value="0" />
                        <el-option label="临时抽调" :value="1" />
                        <el-option label="休假" :value="2" />
                        <el-option label="其它" :value="3" />
                    </el-select>
                </el-form-item>

                <el-form-item label="备注" prop="remarks">
                    <el-input
                        v-model="registerForm.remarks"
                        type="textarea"
                        placeholder="备注信息（可选）"
                        :rows="2"
                        maxlength="200"
                    />
                </el-form-item>
            </el-form>

            <template #footer>
                <el-button @click="registerVisible = false">取消</el-button>
                <el-button type="primary" :loading="registerLoading" @click="handleRegisterSubmit">
                    {{ registerLoading ? '注册中...' : '确认注册' }}
                </el-button>
            </template>
        </el-dialog>
        <AiChatDialog />
    </div>
</template>

<script setup>
import { ref, reactive, computed, onMounted, nextTick } from 'vue'
import request from '@/api/index'
import { ElMessage, ElMessageBox } from 'element-plus'
import { useUserStore } from '@/store'
import { getFeedbackList, assignGridMember, getFeedbackDetail } from '@/api/feedback'
import { getAqiList } from '@/api/aqi'
import AiChatDialog from '@/components/AiChatDialog.vue'
import {
    getProvinceStatistics,
    getAqiDistribution,
    getAqiTrend,
    getRealTimeStatistics,
    getCoverageStatistics,
    getStatisticsList,
    getStatisticsDetail
} from '@/api/statistics'
import {
    getAvailableList,
    registerGridMember,
    getAllGridMembers,
    deleteGridMember
} from '@/api/gridmember'
import { getProvinces, getCitiesByProvince } from '@/api/area'
import * as echarts from 'echarts'

const userStore = useUserStore()
const userInfo = computed(() => userStore.userInfo)

const activeTab = ref('feedback')
const aqiList = ref([])

// 反馈列表
const feedbackList = ref([])
const feedbackTotal = ref(0)
const feedbackLoading = ref(false)
const feedbackQuery = reactive({
    pageNum: 1,
    pageSize: 10,
    state: '0',
    keyword: ''
})

// 确认AQI数据列表
const statisticsList = ref([])
const statisticsTotal = ref(0)
const statisticsLoading = ref(false)
const statisticsQuery = reactive({
    pageNum: 1,
    pageSize: 10,
    provinceId: null
})
const statisticsDetailVisible = ref(false)
const statisticsDetail = ref(null)

// 网格员管理
const gridMemberList = ref([])
const gridMemberLoading = ref(false)
const registerVisible = ref(false)
const registerLoading = ref(false)
const registerFormRef = ref()
const provinceList = ref([])
const registerCityList = ref([])

const registerForm = reactive({
    gmId: '',
    gmName: '',
    gmCode: '',
    password: '',
    provinceId: null,
    cityId: null,
    tel: '',
    state: 0,
    remarks: ''
})

// 指派
const assignVisible = ref(false)
const assignLoading = ref(false)
const currentFeedback = ref(null)
const selectedGridMember = ref('')
const availableMembers = ref([])

// 详情
const detailVisible = ref(false)
const detailData = ref(null)

// 统计数据
const currentStatType = ref('province')
const statLoading = ref(false)
const provinceStatisticsList = ref([])
const distributionList = ref([])
const trendList = ref([])
const realTime = ref({})
const coverage = ref({})

// 图表引用
const provinceChartRef = ref(null)
const distributionChartRef = ref(null)
const trendChartRef = ref(null)
let provinceChart = null
let distributionChart = null
let trendChart = null

// 统计信息
const statistics = computed(() => {
    let total = 0, unassigned = 0, assigned = 0, confirmed = 0
    feedbackList.value.forEach(item => {
        total++
        if (item.state === 0) unassigned++
        else if (item.state === 1) assigned++
        else if (item.state === 2) confirmed++
    })
    return { totalFeedback: total, unassigned, assigned, confirmed }
})

// 表单校验规则
const registerRules = {
    gmId: [
        { required: true, message: '请输入手机号', trigger: 'blur' },
        { pattern: /^1[3-9]\d{9}$/, message: '手机号格式不正确', trigger: 'blur' }
    ],
    gmName: [
        { required: true, message: '请输入姓名', trigger: 'blur' },
        { max: 20, message: '姓名不能超过20字', trigger: 'blur' }
    ],
    gmCode: [
        { required: true, message: '请输入登录编码', trigger: 'blur' },
        { max: 20, message: '登录编码不能超过20字', trigger: 'blur' }
    ],
    password: [
        { required: true, message: '请输入密码', trigger: 'blur' },
        { min: 6, max: 20, message: '密码长度必须在6-20位之间', trigger: 'blur' }
    ],
    provinceId: [{ required: true, message: '请选择省份', trigger: 'change' }],
    cityId: [{ required: true, message: '请选择城市', trigger: 'change' }],
    tel: [{ required: true, message: '请输入联系电话', trigger: 'blur' }]
}

// AQI相关方法
const getAqiLabel = (grade) => {
    const item = aqiList.value.find(a => a.aqiId === grade)
    return item ? `${item.chineseExplain}级-${item.aqiExplain}` : `等级${grade}`
}

const getAqiColor = (grade) => {
    const item = aqiList.value.find(a => a.aqiId === grade)
    return item?.color || '#999'
}

const getStateLabel = (state) => {
    const map = { 0: '未指派', 1: '已指派', 2: '已确认' }
    return map[state] || '未知'
}

const getStateType = (state) => {
    const map = { 0: 'warning', 1: 'primary', 2: 'success' }
    return map[state] || 'info'
}

const getGridMemberStateLabel = (state) => {
    const map = { 0: '可工作', 1: '临时抽调', 2: '休假', 3: '其它' }
    return map[state] || '未知'
}

const getGridMemberStateType = (state) => {
    const map = { 0: 'success', 1: 'warning', 2: 'info', 3: 'danger' }
    return map[state] || 'info'
}

// 加载AQI等级
const loadAqiList = async () => {
    try {
        const { data } = await getAqiList()
        aqiList.value = data || []
    } catch (error) {
        console.error('加载AQI等级失败:', error)
    }
}

// 统计类型切换
const handleStatTypeChange = (val) => {
    console.log('切换到统计类型:', val)
    // 销毁旧图表
    destroyCharts()
    // 加载新数据
    loadCurrentStatData()
}

// 销毁图表
const destroyCharts = () => {
    if (provinceChart) { provinceChart.dispose(); provinceChart = null }
    if (distributionChart) { distributionChart.dispose(); distributionChart = null }
    if (trendChart) { trendChart.dispose(); trendChart = null }
}

// 加载当前统计类型的数据
const loadCurrentStatData = async () => {
    statLoading.value = true
    try {
        switch (currentStatType.value) {
            case 'province':
                await loadProvinceStatistics()
                break
            case 'distribution':
                await loadDistribution()
                break
            case 'trend':
                await loadTrend()
                break
            case 'realtime':
                await loadRealtimeAndCoverage()
                break
        }
    } catch (error) {
        console.error('加载统计数据失败:', error)
        ElMessage.error('加载统计数据失败')
    } finally {
        statLoading.value = false
    }
}

// 加载省分组统计
const loadProvinceStatistics = async () => {
    const { data } = await getProvinceStatistics({})
    provinceStatisticsList.value = data || []

    await nextTick()
    renderProvinceChart()
}

// 渲染省分组图表
const renderProvinceChart = () => {
    if (!provinceChartRef.value) return
    if (!provinceChart) {
        provinceChart = echarts.init(provinceChartRef.value)
    }
    const data = provinceStatisticsList.value
    provinceChart.setOption({
        tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
        legend: { data: ['SO₂超标', 'CO超标', 'PM2.5超标', 'AQI超标'], top: 10 },
        grid: { left: '3%', right: '4%', bottom: '3%', containLabel: true },
        xAxis: {
            type: 'category',
            data: data.map(d => d.provinceName || '未知'),
            axisLabel: { interval: 0, rotate: data.length > 8 ? 30 : 0 }
        },
        yAxis: { type: 'value', name: '超标数量' },
        series: [
            { name: 'SO₂超标', type: 'bar', data: data.map(d => d.so2ExceedCount || 0), color: '#f56c6c', barMaxWidth: 30 },
            { name: 'CO超标', type: 'bar', data: data.map(d => d.coExceedCount || 0), color: '#e6a23c', barMaxWidth: 30 },
            { name: 'PM2.5超标', type: 'bar', data: data.map(d => d.spmExceedCount || 0), color: '#409eff', barMaxWidth: 30 },
            { name: 'AQI超标', type: 'bar', data: data.map(d => d.aqiExceedCount || 0), color: '#67c23a', barMaxWidth: 30 }
        ]
    })
    provinceChart.resize()
}

// 加载AQI分布
const loadDistribution = async () => {
    const { data } = await getAqiDistribution()
    distributionList.value = data || []

    await nextTick()
    renderDistributionChart()
}

// 渲染分布图表
const renderDistributionChart = () => {
    if (!distributionChartRef.value) return
    if (!distributionChart) {
        distributionChart = echarts.init(distributionChartRef.value)
    }
    const data = distributionList.value
    distributionChart.setOption({
        tooltip: { trigger: 'item', formatter: '{b}: {c} 条 ({d}%)' },
        legend: { orient: 'vertical', right: '5%', top: 'center', data: data.map(d => d.aqiExplain || '') },
        series: [{
            type: 'pie',
            radius: ['40%', '70%'],
            avoidLabelOverlap: true,
            itemStyle: { borderRadius: 8, borderColor: '#fff', borderWidth: 2 },
            label: { show: true, formatter: '{b}\n{c} 条 ({d}%)' },
            data: data.map(d => ({
                name: d.aqiExplain || `等级${d.aqiId}`,
                value: d.count || 0,
                itemStyle: { color: d.color || '#999' }
            }))
        }]
    })
    distributionChart.resize()
}

// 加载趋势
const loadTrend = async () => {
    const { data } = await getAqiTrend()
    trendList.value = data || []

    await nextTick()
    renderTrendChart()
}

// 渲染趋势图表
const renderTrendChart = () => {
    if (!trendChartRef.value) return
    if (!trendChart) {
        trendChart = echarts.init(trendChartRef.value)
    }
    const data = trendList.value
    trendChart.setOption({
        tooltip: { trigger: 'axis' },
        grid: { left: '3%', right: '4%', bottom: '3%', containLabel: true },
        xAxis: {
            type: 'category',
            data: data.map(d => d.month || ''),
            boundaryGap: false,
            axisLabel: { rotate: data.length > 12 ? 30 : 0 }
        },
        yAxis: { type: 'value', name: '超标数量' },
        series: [{
            type: 'line',
            data: data.map(d => d.exceedCount || 0),
            smooth: true,
            areaStyle: { color: 'rgba(46, 125, 50, 0.2)' },
            lineStyle: { color: '#2e7d32', width: 3 },
            itemStyle: { color: '#2e7d32' },
            label: { show: true, position: 'top', formatter: '{c}' }
        }]
    })
    trendChart.resize()
}

// 加载实时统计和覆盖率
const loadRealtimeAndCoverage = async () => {
    const [realRes, coverageRes] = await Promise.all([
        getRealTimeStatistics(),
        getCoverageStatistics()
    ])
    realTime.value = realRes.data || {}
    coverage.value = coverageRes.data || {}
}

// 加载反馈列表
const loadFeedbackList = async () => {
    feedbackLoading.value = true
    try {
        const { data } = await getFeedbackList(feedbackQuery)
        if (data) {
            feedbackList.value = data.records || []
            feedbackTotal.value = data.total || 0
        }
    } catch (error) {
        ElMessage.error('加载反馈列表失败')
    } finally {
        feedbackLoading.value = false
    }
}

// 加载省份列表
const loadProvinceList = async () => {
    try {
        const res = await request({ url: '/area/provinces', method: 'get' })
        if (res.data) {
            provinceList.value = res.data
        }
    } catch (e) {
        console.warn('加载省份列表失败:', e)
    }
}

// 加载确认AQI数据列表（分页）
const loadStatisticsList = async () => {
    statisticsLoading.value = true
    try {
        const params = {
            pageNum: statisticsQuery.pageNum,
            pageSize: statisticsQuery.pageSize,
            provinceId: statisticsQuery.provinceId || null
        }
        const res = await getStatisticsList(params)
        const data = res.data || res
        if (data) {
            statisticsList.value = data.records || []
            statisticsTotal.value = data.total || 0
        }
    } catch (error) {
        ElMessage.error('加载AQI确认数据失败')
    } finally {
        statisticsLoading.value = false
    }
}

const handleStatisticsSearch = () => {
    statisticsQuery.pageNum = 1
    loadStatisticsList()
}

const handleStatisticsReset = () => {
    statisticsQuery.provinceId = null
    statisticsQuery.pageNum = 1
    loadStatisticsList()
}

// 加载网格员列表
const loadGridMemberList = async () => {
    gridMemberLoading.value = true
    try {
        const { data } = await getAllGridMembers()
        gridMemberList.value = data || []
    } catch (error) {
        ElMessage.error('加载网格员列表失败')
    } finally {
        gridMemberLoading.value = false
    }
}

// 查看反馈详情
const viewFeedbackDetail = async (row) => {
    try {
        const { data } = await getFeedbackDetail(row.afId)
        detailData.value = data
        detailVisible.value = true
    } catch (error) {
        ElMessage.error('获取详情失败')
    }
}

// 查看AQI确认数据详情
const viewStatisticsDetail = async (row) => {
    try {
        const { data } = await getStatisticsDetail(row.id)
        statisticsDetail.value = data
        statisticsDetailVisible.value = true
    } catch (error) {
        ElMessage.error('获取详情失败')
    }
}

// 打开指派弹窗
const openAssignDialog = async (row) => {
    currentFeedback.value = row
    selectedGridMember.value = ''

    try {
        const { data } = await getAvailableList()
        availableMembers.value = data || []
        if (row.provinceId && row.cityId) {
            const sameArea = data.filter(m =>
                m.provinceId === row.provinceId && m.cityId === row.cityId
            )
            if (sameArea.length > 0) {
                availableMembers.value = sameArea
            }
        }
        assignVisible.value = true
    } catch (error) {
        ElMessage.error('获取网格员列表失败')
    }
}

// 确认指派
const handleAssign = async () => {
    if (!selectedGridMember.value || !currentFeedback.value) return

    assignLoading.value = true
    try {
        const { data } = await assignGridMember(
            currentFeedback.value.afId,
            selectedGridMember.value
        )
        if (data) {
            ElMessage.success('指派成功！')
            assignVisible.value = false
            loadFeedbackList()
        }
    } catch (error) {
        ElMessage.error(error.message || '指派失败')
    } finally {
        assignLoading.value = false
    }
}

// ============ 网格员注册相关 ============

// 打开注册弹窗
const openRegisterDialog = async () => {
    // 加载省份列表
    if (provinceList.value.length === 0) {
        try {
            const { data } = await getProvinces()
            provinceList.value = data || []
        } catch (error) {
            console.error('加载省份失败:', error)
        }
    }

    // 重置表单
    Object.assign(registerForm, {
        gmId: '',
        gmName: '',
        gmCode: '',
        password: '',
        provinceId: null,
        cityId: null,
        tel: '',
        state: 0,
        remarks: ''
    })
    registerCityList.value = []

    registerVisible.value = true
}

// 注册时省份变更
const handleRegisterProvinceChange = async (val) => {
    registerForm.cityId = null
    if (val) {
        try {
            const { data } = await getCitiesByProvince(val)
            registerCityList.value = data || []
        } catch (error) {
            registerCityList.value = []
        }
    } else {
        registerCityList.value = []
    }
}

// 提交注册
const handleRegisterSubmit = async () => {
    if (!registerFormRef.value) return

    try {
        await registerFormRef.value.validate()

        registerLoading.value = true
        const { data } = await registerGridMember({
            gmId: registerForm.gmId,
            gmName: registerForm.gmName,
            gmCode: registerForm.gmCode,
            password: registerForm.password,
            provinceId: registerForm.provinceId,
            cityId: registerForm.cityId,
            tel: registerForm.tel,
            state: registerForm.state,
            remarks: registerForm.remarks
        })

        if (data) {
            ElMessage.success('网格员注册成功！')
            registerVisible.value = false
            loadGridMemberList()
        }
    } catch (error) {
        if (error.message) {
            ElMessage.error(error.message)
        }
    } finally {
        registerLoading.value = false
    }
}

// 删除网格员
const handleDeleteGridMember = (row) => {
    ElMessageBox.confirm(
        `确认删除网格员 ${row.gmName}（${row.gmId}）吗？删除后不可恢复。`,
        '删除确认',
        {
            confirmButtonText: '确认删除',
            cancelButtonText: '取消',
            type: 'warning'
        }
    ).then(async () => {
        try {
            const { data } = await deleteGridMember(row.gmId)
            if (data) {
                ElMessage.success('删除成功！')
                loadGridMemberList()
            }
        } catch (error) {
            ElMessage.error(error.message || '删除失败')
        }
    }).catch(() => {})
}


// 加载统计数据
const loadStatistics = async () => {
    try {
        const [realRes, coverageRes] = await Promise.all([
            getRealTimeStatistics(),
            getCoverageStatistics()
        ])
        realTime.value = realRes.data || {}
        coverage.value = coverageRes.data || {}
    } catch (error) {
        console.error('加载统计数据失败:', error)
    }
}

// Tab切换处理
const handleTabChange = (name) => {
    if (name === 'statistics') {
        loadCurrentStatData()
    } else if (name === 'aqiData') {
        loadStatisticsList()
    } else if (name === 'gridMember') {
        loadGridMemberList()
    }
}

// 渲染图表
const renderCharts = async () => {
    await nextTick()

    try {
        const { data } = await getProvinceStatistics({})
        if (data && provinceChartRef.value) {
            if (!provinceChart) {
                provinceChart = echarts.init(provinceChartRef.value)
            }
            provinceChart.setOption({
                tooltip: { trigger: 'axis' },
                legend: { data: ['SO₂超标', 'CO超标', 'PM2.5超标', 'AQI超标'] },
                xAxis: { type: 'category', data: data.map(d => d.provinceName || '未知') },
                yAxis: { type: 'value', name: '超标数量' },
                series: [
                    { name: 'SO₂超标', type: 'bar', data: data.map(d => d.so2ExceedCount || 0), color: '#f56c6c' },
                    { name: 'CO超标', type: 'bar', data: data.map(d => d.coExceedCount || 0), color: '#e6a23c' },
                    { name: 'PM2.5超标', type: 'bar', data: data.map(d => d.spmExceedCount || 0), color: '#409eff' },
                    { name: 'AQI超标', type: 'bar', data: data.map(d => d.aqiExceedCount || 0), color: '#67c23a' }
                ]
            })
            provinceChart.resize()
        }
    } catch (error) {
        console.error('渲染省分组图表失败:', error)
    }

    try {
        const { data } = await getAqiDistribution()
        if (data && distributionChartRef.value) {
            if (!distributionChart) {
                distributionChart = echarts.init(distributionChartRef.value)
            }
            distributionChart.setOption({
                tooltip: { trigger: 'item', formatter: '{b}: {c} ({d}%)' },
                legend: { orient: 'vertical', right: '5%', top: 'center', data: data.map(d => d.aqiExplain || '') },
                series: [{
                    type: 'pie',
                    radius: ['40%', '70%'],
                    avoidLabelOverlap: true,
                    itemStyle: { borderRadius: 8, borderColor: '#fff', borderWidth: 2 },
                    label: { show: true, formatter: '{b}\n{d}%' },
                    data: data.map(d => ({
                        name: d.aqiExplain || `等级${d.aqiId}`,
                        value: d.count || 0,
                        itemStyle: { color: d.color || '#999' }
                    }))
                }]
            })
            distributionChart.resize()
        }
    } catch (error) {
        console.error('渲染分布图表失败:', error)
    }

    try {
        const { data } = await getAqiTrend()
        if (data && trendChartRef.value) {
            if (!trendChart) {
                trendChart = echarts.init(trendChartRef.value)
            }
            trendChart.setOption({
                tooltip: { trigger: 'axis' },
                xAxis: { type: 'category', data: data.map(d => d.month || ''), boundaryGap: false },
                yAxis: { type: 'value', name: '超标数量' },
                series: [{
                    type: 'line',
                    data: data.map(d => d.exceedCount || 0),
                    smooth: true,
                    areaStyle: { color: 'rgba(46, 125, 50, 0.2)' },
                    lineStyle: { color: '#2e7d32', width: 3 },
                    itemStyle: { color: '#2e7d32' }
                }]
            })
            trendChart.resize()
        }
    } catch (error) {
        console.error('渲染趋势图表失败:', error)
    }
}

// 窗口自适应
const handleResize = () => {
    provinceChart?.resize()
    distributionChart?.resize()
    trendChart?.resize()
}

onMounted(() => {
    loadAqiList()
    loadProvinceList()
    loadFeedbackList()
    loadStatistics()
    window.addEventListener('resize', handleResize)
})
</script>

